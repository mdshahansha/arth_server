{
  "info": {
    "name": "Arth Dashboard API",
    "description": "Complete API collection for the Arth Dashboard backend.\n\nHow to use:\n1. Run 'Register' first (or use seeded demo user)\n2. Run 'Login' — token is auto-saved to {{token}}\n3. All protected endpoints automatically use Bearer {{token}}\n\nSeeded demo credentials:\n  Email: demo@example.com\n  Password: Demo@1234",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
        "description": "Check if the server is running. No auth required."
      },
      "response": [
        { "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": { \"status\": \"ok\" },\n  \"message\": \"Server is running\"\n}" }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"John@1234\",\n  \"profileImageUrl\": \"https://api.dicebear.com/7.x/avataaars/svg?seed=john\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Register a new user.\n\nPassword rules:\n- Min 8 chars\n- At least 1 uppercase, 1 lowercase, 1 number, 1 special character\n\nprofileImageUrl is optional."
          },
          "response": [
            { "name": "201 Created", "status": "Created", "code": 201, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"profile_image_url\": \"https://api.dicebear.com/7.x/avataaars/svg?seed=john\",\n    \"created_at\": \"2026-06-12T00:00:00.000Z\",\n    \"updated_at\": \"2026-06-12T00:00:00.000Z\"\n  },\n  \"message\": \"User registered successfully\"\n}" },
            { "name": "409 Email Taken", "status": "Conflict", "code": 409, "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"EMAIL_TAKEN\",\n    \"message\": \"A user with this email already exists\"\n  }\n}" },
            { "name": "400 Validation Error", "status": "Bad Request", "code": 400, "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"Validation failed\",\n    \"details\": [{ \"field\": \"password\", \"message\": \"Password must contain at least one uppercase letter\" }]\n  }\n}" }
          ]
        },
        {
          "name": "Login (Demo User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token', data.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"Demo@1234\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Login with seeded demo user. Token is auto-saved to {{token}}."
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"user\": {\n      \"id\": \"uuid\",\n      \"name\": \"Demo User\",\n      \"email\": \"demo@example.com\",\n      \"profile_image_url\": \"https://api.dicebear.com/7.x/avataaars/svg?seed=demo\"\n    }\n  },\n  \"message\": \"Login successful\"\n}" },
            { "name": "401 Wrong Password", "status": "Unauthorized", "code": 401, "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"INVALID_CREDENTIALS\",\n    \"message\": \"Invalid email or password\"\n  }\n}" }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Invalidates the JWT session in Redis. After this, the same token returns 401."
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": null,\n  \"message\": \"Logged out successfully\"\n}" }
          ]
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard", "host": ["{{baseUrl}}"], "path": ["dashboard"] },
            "description": "Returns user profile + spend statistics:\n- Total spend & income\n- Monthly breakdown (last 6 months)\n- Category-wise spend breakdown\n\nRequires valid JWT."
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"user\": { \"id\": \"uuid\", \"name\": \"Demo User\", \"email\": \"demo@example.com\" },\n    \"totalSpend\": 56496.25,\n    \"totalIncome\": 191065.77,\n    \"monthlyBreakdown\": [\n      { \"month\": \"2026-01\", \"debit\": 15086.00, \"credit\": 22623.80 }\n    ],\n    \"categoryBreakdown\": [\n      { \"category\": \"entertainment\", \"amount\": 16998.44 },\n      { \"category\": \"food\", \"amount\": 3898.62 }\n    ]\n  },\n  \"message\": \"Dashboard data retrieved\"\n}" }
          ]
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get Transactions (paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/transactions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Paginated transactions sorted by date DESC.\n\nQuery params:\n- page: positive integer (default: 1)\n- limit: 1-50 (default: 10, max: 50)"
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"items\": [\n      {\n        \"id\": \"uuid\",\n        \"title\": \"Water Bill\",\n        \"category\": \"bills\",\n        \"amount\": \"1514.44\",\n        \"type\": \"debit\",\n        \"transaction_date\": \"2026-06-10T02:50:23.000Z\"\n      }\n    ],\n    \"pagination\": {\n      \"page\": 1,\n      \"limit\": 10,\n      \"totalItems\": 48,\n      \"totalPages\": 5,\n      \"hasNext\": true,\n      \"hasPrev\": false\n    }\n  },\n  \"message\": \"Transactions retrieved\"\n}" }
          ]
        }
      ]
    },
    {
      "name": "Wallets",
      "item": [
        {
          "name": "Get Wallets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/wallets", "host": ["{{baseUrl}}"], "path": ["wallets"] },
            "description": "Returns all wallets for the authenticated user with total balance.\n\nEach user has 4 wallets (bank, cash, credit, savings) created by the seeder."
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"wallets\": [\n      {\n        \"id\": \"uuid\",\n        \"user_id\": \"user-uuid\",\n        \"name\": \"Main Account\",\n        \"type\": \"bank\",\n        \"account_number\": \"****4821\",\n        \"balance\": \"8500000.00\",\n        \"color\": \"#167AFF\"\n      },\n      {\n        \"id\": \"uuid\",\n        \"name\": \"Cash Wallet\",\n        \"type\": \"cash\",\n        \"account_number\": null,\n        \"balance\": \"750000.00\",\n        \"color\": \"#31BA96\"\n      },\n      {\n        \"id\": \"uuid\",\n        \"name\": \"Credit Card\",\n        \"type\": \"credit\",\n        \"balance\": \"-1150000.00\",\n        \"color\": \"#B548C6\"\n      },\n      {\n        \"id\": \"uuid\",\n        \"name\": \"Savings\",\n        \"type\": \"savings\",\n        \"balance\": \"12000000.00\",\n        \"color\": \"#FF8701\"\n      }\n    ],\n    \"totalBalance\": 20100000\n  },\n  \"message\": \"Wallets retrieved\"\n}" }
          ]
        }
      ]
    },
    {
      "name": "Tips",
      "item": [
        {
          "name": "Get All Tips (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tips", "host": ["{{baseUrl}}"], "path": ["tips"] },
            "description": "Returns all financial tips. No auth required.\n\nIf authenticated (Bearer token provided), also returns savedIds — array of tip IDs the user has bookmarked."
          },
          "response": [
            { "name": "200 OK (unauthenticated)", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"tips\": [\n      {\n        \"id\": \"uuid\",\n        \"category\": \"Saving\",\n        \"icon\": \"savings\",\n        \"title\": \"The 50/30/20 Rule\",\n        \"body\": \"Allocate 50% to needs, 30% to wants, and 20% to savings...\",\n        \"read_time\": \"4 min\",\n        \"featured\": true\n      }\n    ],\n    \"savedIds\": []\n  },\n  \"message\": \"Tips retrieved\"\n}" },
            { "name": "200 OK (authenticated)", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"tips\": [\"... same as above ...\"],\n    \"savedIds\": [\"tip-uuid-1\", \"tip-uuid-2\"]\n  },\n  \"message\": \"Tips retrieved\"\n}" }
          ]
        },
        {
          "name": "Get All Tips (authenticated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/tips", "host": ["{{baseUrl}}"], "path": ["tips"] },
            "description": "Same endpoint but with auth token — savedIds will contain the user's bookmarked tip IDs."
          }
        },
        {
          "name": "Toggle Save Tip (bookmark)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/tips/:tipId/save", "host": ["{{baseUrl}}"], "path": ["tips", ":tipId", "save"] },
            "description": "Toggle bookmark on a tip. If already saved, it unsaves; if not saved, it saves.\n\nReplace :tipId with an actual tip UUID from the GET /tips response.\n\nRequires valid JWT."
          },
          "response": [
            { "name": "200 Saved", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": { \"saved\": true },\n  \"message\": \"Tip saved\"\n}" },
            { "name": "200 Unsaved", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": { \"saved\": false },\n  \"message\": \"Tip unsaved\"\n}" }
          ]
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\",\n  \"email\": \"newemail@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/settings/profile", "host": ["{{baseUrl}}"], "path": ["settings", "profile"] },
            "description": "Update the authenticated user's profile.\n\nAccepted fields: name, email, profile_image_url.\nAll fields are optional — only provided fields are updated."
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"name\": \"Updated Name\",\n    \"email\": \"newemail@example.com\",\n    \"profile_image_url\": \"https://...\",\n    \"created_at\": \"...\",\n    \"updated_at\": \"...\"\n  },\n  \"message\": \"Profile updated\"\n}" }
          ]
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Demo@1234\",\n  \"newPassword\": \"NewPass@5678\"\n}" },
            "url": { "raw": "{{baseUrl}}/settings/password", "host": ["{{baseUrl}}"], "path": ["settings", "password"] },
            "description": "Change the authenticated user's password.\n\nRequires current password for verification.\nNew password must meet the same rules as registration."
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": null,\n  \"message\": \"Password changed\"\n}" },
            { "name": "401 Wrong Current Password", "status": "Unauthorized", "code": 401, "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"INVALID_CREDENTIALS\",\n    \"message\": \"Current password is incorrect\"\n  }\n}" }
          ]
        }
      ]
    }
  ]
}
